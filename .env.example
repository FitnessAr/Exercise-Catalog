# Database - Supabase PostgreSQL
# Pooler (puerto 6543). Para Vercel/serverless agregá al final: ?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.[TU-PROYECTO]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Conexión directa (puerto 5432) - la usa Prisma CLI (migraciones / db push)
DIRECT_URL="postgresql://postgres.[TU-PROYECTO]:[PASSWORD]@db.[TU-PROYECTO].supabase.co:5432/postgres"

# API Key for catalog access
CATALOG_API_KEY="genera-una-api-key-segura-aqui"

# CORS
ALLOWED_ORIGINS="http://localhost:3000"
